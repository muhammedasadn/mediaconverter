<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- App-specific external: Android/data/com.muhammedasadn.mediaconverter/files/ -->
    <external-files-path
        name="hazel_downloads"
        path="MediaConverter/" />
    <external-files-path
        name="hazel_music"
        path="Music/" />
    <!-- Public Downloads: /storage/emulated/0/Download/MediaConverter/ -->
    <external-path
        name="public_downloads"
        path="Download/MediaConverter/" />
    <!-- Public Music: /storage/emulated/0/Music/MediaConverter/ -->
    <external-path
        name="public_music"
        path="Music/MediaConverter/" />
    <!-- App updates cache: getCacheDir()/updates/ -->
    <cache-path
        name="updates"
        path="updates/" />
</paths>
